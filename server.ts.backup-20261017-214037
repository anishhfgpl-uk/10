  res.json(ageing);
});

// 7. Group Overall Ageing Analytics
app.get('/api/tally/group-ageing/:groupId', (req: Request, res: Response) => {
  const { groupId } = req.params;
  const { ledgers, vouchers } = getActiveCompanyData();

  const targetLedgers =
    groupId === 'grp_all' || groupId === 'all'
      ? ledgers
      : ledgers.filter((l) => l.groupId === groupId);

  let b0_30 = 0;
  let b31_60 = 0;
  let b61_90 = 0;
  let b91_120 = 0;
  let b120Plus = 0;
  let totalOutstanding = 0;
  let totalOverdue = 0;

  for (const led of targetLedgers) {
    const ledVchs = vouchers.filter((v) => v.ledgerId === led.id);
    const ageing = computeAgeingAnalysis(led, ledVchs, new Date().toISOString().slice(0, 10));
    b0_30 += ageing.bucket0_30;
    b31_60 += ageing.bucket31_60;
    b61_90 += ageing.bucket61_90;
    b91_120 += ageing.bucket91_120;
    b120Plus += ageing.bucket120Plus;
    totalOutstanding += ageing.totalOutstanding;
    totalOverdue += ageing.totalOverdue;
  }

  res.json({
    groupId,
    totalLedgers: targetLedgers.length,
    bucket0_30: b0_30,
    bucket31_60: b31_60,
    bucket61_90: b61_90,
    bucket91_120: b91_120,
    bucket120Plus: b120Plus,
    totalOutstanding,
    totalOverdue,
  });
});

// 8. SECURE SYNC ENDPOINT (for office / local PC automated sync via script)
app.post('/api/tally/sync', (req: Request, res: Response) => {
  const apiKey = (req.headers['x-tally-api-key'] || req.query.apiKey) as string;

  // Find company by apiKey
  let targetCompany = db.companies.find((c) => c.apiKey === apiKey);
  if (!targetCompany) {
    // If no matching key, check active company or create new
    targetCompany = db.companies.find((c) => c.id === db.activeCompanyId) || db.companies[0];
  }

  let importedData: {
    companyName?: string;
    groups?: DebtorGroup[];
    ledgers?: DebtorLedger[];
    vouchers?: TallyVoucher[];
  } = {};

  const contentType = req.headers['content-type'] || '';

  if (contentType.includes('xml') || typeof req.body === 'string') {
    const rawXml = typeof req.body === 'string' ? req.body : req.body.toString();
    importedData = parseTallyXML(rawXml);
  } else {
    importedData = req.body;
  }

  if (!importedData.ledgers || importedData.ledgers.length === 0) {
    res.status(400).json({
      error: 'No debtor ledger data received in sync payload',
      receivedKeys: Object.keys(req.body || {}),
    });
    return;
  }

  // Update target company
  targetCompany.lastSyncedAt = new Date().toISOString();
  targetCompany.syncSource = (req.headers['x-sync-source'] as string) || 'Cloud Tally Sync Agent';

  const compId = targetCompany.id;

  // Upsert or Merge groups
  if (importedData.groups && importedData.groups.length > 0) {
    const existingGroups = db.groups[compId] || [];
    const grpMap = new Map(existingGroups.map((g) => [g.id, g]));
    importedData.groups.forEach((g) => grpMap.set(g.id, g));
    db.groups[compId] = Array.from(grpMap.values());
  }

  // Upsert Ledgers
  const existingLedgers = db.ledgers[compId] || [];
  const ledMap = new Map(existingLedgers.map((l) => [l.id, l]));
  importedData.ledgers.forEach((l) => ledMap.set(l.id, l));
  db.ledgers[compId] = Array.from(ledMap.values());

  // Upsert Vouchers
  if (importedData.vouchers && importedData.vouchers.length > 0) {
    const existingVchs = db.vouchers[compId] || [];
    const vchMap = new Map(existingVchs.map((v) => [v.id, v]));
    importedData.vouchers.forEach((v) => vchMap.set(v.id, v));
    db.vouchers[compId] = Array.from(vchMap.values());
  }

  saveDatabase(db);

  res.json({
    success: true,
    message: 'Tally data successfully synced and saved to cloud!',
    company: targetCompany.name,
    syncedLedgersCount: importedData.ledgers.length,
    syncedVouchersCount: importedData.vouchers?.length || 0,
    timestamp: targetCompany.lastSyncedAt,
  });
});

// 9. Browser XML Upload endpoint
app.post('/api/tally/upload-xml', (req: Request, res: Response) => {
  const rawXml = typeof req.body === 'string' ? req.body : req.body.xmlContent || '';

  if (!rawXml) {
    res.status(400).json({ error: 'Empty XML file received' });
    return;
  }

  const parsed = parseTallyXML(rawXml);

  if (parsed.ledgers.length === 0 && parsed.vouchers.length === 0) {
    res.status(400).json({
      error: 'Could not detect any Debtor ledgers or vouchers in the uploaded Tally XML.',
    });
    return;
  }

  const compId = db.activeCompanyId;
  const comp = db.companies.find((c) => c.id === compId);

  if (comp) {
    comp.lastSyncedAt = new Date().toISOString();
    comp.syncSource = 'Direct Tally XML Import';
    if (parsed.companyName && parsed.companyName !== 'Imported Tally Company') {
      comp.name = parsed.companyName;
    }
  }

  // Update cloud db
  db.groups[compId] = parsed.groups.length > 0 ? parsed.groups : (db.groups[compId] || SEED_GROUPS);
  db.ledgers[compId] = parsed.ledgers.length > 0 ? parsed.ledgers : (db.ledgers[compId] || []);
  db.vouchers[compId] = parsed.vouchers.length > 0 ? parsed.vouchers : (db.vouchers[compId] || []);

  saveDatabase(db);

  res.json({
    success: true,
    companyName: comp?.name || parsed.companyName,
    importedLedgers: parsed.ledgers.length,
    importedVouchers: parsed.vouchers.length,
    importedGroups: parsed.groups.length,
  });
});

