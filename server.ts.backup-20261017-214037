  const { id } = req.params;
  const { asOfDate } = req.query as { asOfDate?: string };
  const { ledgers, vouchers } = getActiveCompanyData();

  const ledger = ledgers.find((l) => l.id === id);
  if (!ledger) {
    res.status(404).json({ error: 'Ledger not found' });
